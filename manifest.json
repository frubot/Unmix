{
  "manifest_version": 3,
  "name": "Unmix",
  "version": "0.1.0",
  "description": "Route each tab's audio to the left ear, right ear, or both — independently per tab.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "tabs", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unmix — per-tab audio pan",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
